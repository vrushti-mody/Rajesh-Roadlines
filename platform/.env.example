# --- Core -------------------------------------------------------------
PUBLIC_URL=https://app.rajeshrpl.in
DATABASE_URL=postgres://rrpl:CHANGE_ME@localhost:5432/rrpl
# 32+ random characters: `openssl rand -hex 32`
PAYLOAD_SECRET=
# Sites allowed to call the public API (the one-page website)
ALLOWED_ORIGINS=https://rajeshrpl.in,https://www.rajeshrpl.in

# First admin, created by `npm run seed` when there are no users yet
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- File storage (complaint photos, news images) ----------------------
# Leave S3_BUCKET empty to store files on local disk (single server only).
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LR tracking ---------------------------------------------------------
# http = RRPL's existing LR system; mock = sample data for local dev only
TRACKING_PROVIDER=http
# URL template, {branch} and {lr} are replaced
TRACKING_URL=
TRACKING_API_KEY=
# Optional JSON map from our field names to theirs, see src/lib/tracking/http.ts
TRACKING_FIELD_MAP=

# --- WhatsApp Business (Meta Cloud API) -----------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Ops desk number that receives new request alerts, e.g. 9198XXXXXXXX
WHATSAPP_OPS_NUMBER=

# --- Ask RRPL chatbot (Anthropic API) --------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Spam protection (optional, Cloudflare Turnstile) ----------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
